{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/data/gallery.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/send-invoice-email",
      "destination": "/api/invoice?__route=send-invoice-email"
    },
    {
      "source": "/api/send-invoice-pdf",
      "destination": "/api/invoice?__route=send-invoice-pdf"
    },
    {
      "source": "/api/send-whatsapp-confirmation",
      "destination": "/api/whatsapp"
    },
    {
      "source": "/api/tabby-payment",
      "destination": "/api/tabby?__route=tabby-payment"
    },
    {
      "source": "/api/tabby-webhook",
      "destination": "/api/tabby?__route=tabby-webhook"
    },
    {
      "source": "/api/tamara-payment",
      "destination": "/api/tamara?__route=tamara-payment"
    },
    {
      "source": "/api/tamara-webhook",
      "destination": "/api/tamara?__route=tamara-webhook"
    }
  ]
}
